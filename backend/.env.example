# Copia este archivo como .env y ajusta la ruta de ESTA PC.
# La base de datos siempre vive local; la sincronizacion entre PCs
# la hacen INICIAR_DonPeppini.bat (pull) y CERRAR_DonPeppini.bat (push)
# usando la carpeta boveda configurada en CONFIG_LOCAL.txt
DB_PATH=C:\Users\TuUsuario\Desktop\DonPeppiniContadore\backend\db.sqlite3
